# ==============================================================================
# XANH HUB VIETNAM - CẤU HÌNH MÔI TRƯỜNG PHÁT TRIỂN & CHẠY THỬ (LOCAL DEV / SANDBOX)
# Đề tài 6: Xây dựng hệ thống tổ chức hoạt động và phân công tình nguyện viên
# ==============================================================================
# Hướng dẫn:
# 1. Sao chép tệp này thành '.env': cp .env.example .env
# 2. Cập nhật các thông tin cấu hình phù hợp với môi trường máy chủ của bạn.
# 3. Khi các khóa OAuth Client ID để dạng placeholder (your-..., mock-...),
#    hệ thống sẽ tự động kích hoạt chế độ "Sandbox Mock Auth" an toàn để kiểm thử
#    nghiệp vụ điều phối và phân công mà không cần kết nối API thực tế ra Internet.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. THÔNG TIN ỨNG DỤNG (APPLICATION CORE)
# ------------------------------------------------------------------------------
APP_NAME="Xanh Hub Vietnam"
APP_ENV=local
APP_DEBUG=true
APP_URL="http://localhost:8080"
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Khóa bí mật mã hóa phiên ứng dụng (dùng cho cookie session, CSRF và mã hóa dự phòng)
APP_SECRET="xanhhub-open-source-demo-secret-key-2026"

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (POSTGRESQL 16+)
# ------------------------------------------------------------------------------
# Môi trường chạy trực tiếp (Local/XAMPP): 127.0.0.1
# Môi trường container Docker: db
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=xanhhub
DB_USERNAME=postgres
# Mật khẩu người dùng PostgreSQL (để trống nếu PostgreSQL dùng Trust Auth, hoặc điền mật khẩu của bạn)
DB_PASSWORD=""

# ------------------------------------------------------------------------------
# 3. KHÓA KÝ SỐ MÃ QR ĐIỂM DANH XOAY VÒNG 30 GIÂY (HMAC-SHA256 SIGNING)
# ------------------------------------------------------------------------------
# Khóa HMAC bí mật để ký số mã QR chống chụp ảnh màn hình điểm danh hộ.
# Ưu tiên đọc HMAC_SECRET, nếu chưa có sẽ fallback về APP_SECRET.
HMAC_SECRET="xanhhub_rotating_qr_hmac_secret_key_30s_2026"
QR_ROTATION_SECONDS=30

# ------------------------------------------------------------------------------
# 4. CHẾ ĐỘ MÔ PHỎNG XÁC THỰC OAUTH 2.0 (OAUTH MOCK MODE)
# ------------------------------------------------------------------------------
# Giá trị:
# - auto       : Tự động dùng Mock Auth nếu Client ID rỗng hoặc bắt đầu bằng 'your-', 'mock-'
# - force_mock : Bắt buộc dùng Sandbox Mock Auth cho tất cả các nhà cung cấp
# - strict     : Yêu cầu kết nối Real OAuth bắt buộc ra các nhà cung cấp bên ngoài
OAUTH_MOCK_MODE=auto

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH XÁC THỰC OAUTH 2.0 ĐA NỀN TẢNG (5 NHÀ CUNG CẤP)
# ------------------------------------------------------------------------------
# Lưu ý bảo mật: Không bao giờ commit thông tin API Secret thực tế vào Git repository.

# [5.1] Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# Scopes: openid, email, profile
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8080/?action=oauth_callback&provider=google"

# [5.2] Zalo OAuth 2.0 (Zalo for Developers -> My Apps -> Login Social API)
# Scopes: default (id, name, picture)
ZALO_APP_ID="your-zalo-app-id"
ZALO_APP_SECRET="your-zalo-app-secret"
ZALO_REDIRECT_URI="http://localhost:8080/?action=oauth_callback&provider=zalo"

# [5.3] Microsoft Edu OAuth 2.0 (Azure Portal -> Microsoft Entra ID -> App Registrations)
# Phục vụ sinh viên đăng nhập bằng email trường (.edu.vn / Office 365 Education)
# Scopes: openid, email, profile, User.Read
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_REDIRECT_URI="http://localhost:8080/?action=oauth_callback&provider=microsoft"
MICROSOFT_TENANT_ID="common"

# [5.4] Facebook Login OAuth 2.0 (Meta for Developers -> Apps -> Facebook Login)
# Scopes: email, public_profile
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_REDIRECT_URI="http://localhost:8080/?action=oauth_callback&provider=facebook"

# [5.5] GitHub OAuth 2.0 (GitHub -> Settings -> Developer settings -> OAuth Apps)
# Scopes: read:user, user:email
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_REDIRECT_URI="http://localhost:8080/?action=oauth_callback&provider=github"

# ------------------------------------------------------------------------------
# 6. TÍCH HỢP TRÍ TUỆ NHÂN TẠO HYBRID AI (OLLAMA / GOOGLE COLAB LLM FALLBACK)
# ------------------------------------------------------------------------------
AI_ENABLED=false
AI_ENDPOINT_URL="http://localhost:11434/api/generate"
AI_MODEL_NAME="qwen2.5:3b-xanhhub-lora"
AI_TIMEOUT_SECONDS=3

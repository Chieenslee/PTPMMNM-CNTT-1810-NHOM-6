# ==============================================================================
# XANH HUB VIETNAM - CẤU HÌNH MÔI TRƯỜNG PRODUCTION (DOCKER DEPLOYMENT)
# Đề tài 6: Xây dựng hệ thống tổ chức hoạt động và phân công tình nguyện viên
# ==============================================================================
# Tệp này được cấu hình sẵn để triển khai đồng bộ cùng docker-compose.yml.
# Lưu ý an toàn: Đảm bảo bảo vệ tệp này với quyền hạn 600 trên máy chủ Linux.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. THÔNG TIN ỨNG DỤNG (APPLICATION CORE - PRODUCTION)
# ------------------------------------------------------------------------------
APP_NAME="Xanh Hub Vietnam - Production"
APP_ENV=production
APP_DEBUG=false
APP_URL="http://localhost:8080"
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Khóa bí mật mã hóa ứng dụng sản xuất (Chuỗi entropy bảo mật cao 32-byte hex)
APP_SECRET="xh_sec_prod_9f8a7c2b5e3d1a4f0b6e8d2c7a5b3e1f"

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (DOCKER SERVICE 'db')
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=xanhhub
DB_USERNAME=postgres
DB_PASSWORD="xanhhub_secure_prod_pwd_2026"

# ------------------------------------------------------------------------------
# 3. KHÓA KÝ SỐ MÃ QR ĐIỂM DANH XOAY VÒNG 30 GIÂY (HMAC-SHA256 SIGNING)
# ------------------------------------------------------------------------------
HMAC_SECRET="hmac_prod_30s_qr_8e4a9b2c1d5f7a0b3e6c8d1f2a4b7e9c"
QR_ROTATION_SECONDS=30

# ------------------------------------------------------------------------------
# 4. CHẾ ĐỘ MÔ PHỎNG XÁC THỰC OAUTH 2.0 (OAUTH MOCK MODE)
# ------------------------------------------------------------------------------
# Mặc định 'auto': Nếu khóa chưa được điền thông tin thật từ nhà cung cấp,
# hệ thống tự kích hoạt Sandbox Mock Auth để vận hành ổn định.
OAUTH_MOCK_MODE=auto

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH XÁC THỰC OAUTH 2.0 ĐA NỀN TẢNG (PRODUCTION KEYS)
# ------------------------------------------------------------------------------

# [5.1] Google OAuth 2.0
GOOGLE_CLIENT_ID="your-real-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-real-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8080/?action=oauth_callback&provider=google"

# [5.2] Zalo OAuth 2.0
ZALO_APP_ID="your-real-zalo-app-id"
ZALO_APP_SECRET="your-real-zalo-app-secret"
ZALO_REDIRECT_URI="http://localhost:8080/?action=oauth_callback&provider=zalo"

# [5.3] Microsoft Edu OAuth 2.0 (.edu.vn / Entra ID)
MICROSOFT_CLIENT_ID="your-real-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-real-microsoft-client-secret"
MICROSOFT_REDIRECT_URI="http://localhost:8080/?action=oauth_callback&provider=microsoft"
MICROSOFT_TENANT_ID="common"

# [5.4] Facebook Login OAuth 2.0
FACEBOOK_APP_ID="your-real-facebook-app-id"
FACEBOOK_APP_SECRET="your-real-facebook-app-secret"
FACEBOOK_REDIRECT_URI="http://localhost:8080/?action=oauth_callback&provider=facebook"

# [5.5] GitHub OAuth 2.0
GITHUB_CLIENT_ID="your-real-github-client-id"
GITHUB_CLIENT_SECRET="your-real-github-client-secret"
GITHUB_REDIRECT_URI="http://localhost:8080/?action=oauth_callback&provider=github"

# ------------------------------------------------------------------------------
# 6. TÍCH HỢP TRÍ TUỆ NHÂN TẠO HYBRID AI (OLLAMA / HOST SERVICE)
# ------------------------------------------------------------------------------
AI_ENABLED=false
AI_ENDPOINT_URL="http://localhost:11434/api/generate"
AI_MODEL_NAME="qwen2.5:3b-xanhhub-lora"
AI_TIMEOUT_SECONDS=3
